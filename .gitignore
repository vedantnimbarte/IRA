/target
# Fetched by scripts/fetch-models.ps1 -- ~6 MB of weights, not source.
/models/*.onnx
/models/*.onnx.json
/models/*.bin
/piper/
/whisper/
# Written by IRA at runtime -- a record of your conversations, not source.
/transcript.jsonl
# Written by the settings window: this machine's URLs and model ids. Not keys,
# which go to the OS keyring -- but this is per-machine either way, unlike
# ira.toml, which is shareable.
/ira.local.db
/ira.local.db-journal

# wingman serve keeps its index, sessions and memory here.
.wingman/
